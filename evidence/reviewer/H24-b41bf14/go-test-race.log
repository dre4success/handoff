## runs.sh
#!/usr/bin/env bash
# The reviewer's race runs for H24: run 1 alone with go test's default limit;
# runs 2 and 3 at once (the worktree with the default limit; a copy shuffled
# with -parallel 32 and a 30-minute limit), as several race runs sharing the
# machine; then the two changed tests ten times under -race.
set -u
S=${S:?}; W=$S/wt-h24; R=$S/h24/race
export HANDOFF_TEST_NOTIFY=$R/notify.txt HANDOFF_TEST_AWAKE=$R/awake.txt
t() { date -u '+%Y-%m-%d %H:%M:%S UTC'; }
run() { # name dir args...
  local name=$1 dir=$2; shift 2
  ( cd "$dir" && echo "start $(t)" > "$R/$name.out" && s=$(date +%s) && go test "$@" >> "$R/$name.out" 2>&1; echo "exit $? wall $(( $(date +%s) - s )) s" >> "$R/$name.out"; echo "end $(t)" >> "$R/$name.out" )
}
run run1 "$W" -count=1 -race -v ./...
mkdir -p "$S/h24/copy" && (cd "$W" && git archive HEAD | tar -x -C "$S/h24/copy")
run run2 "$W" -count=1 -race -v ./... &
run run3 "$S/h24/copy" -count=1 -race -v -shuffle=on -parallel 32 -timeout 30m ./... &
wait
run flaky "$W" -race -count=10 -run 'TestH8QuietClaimTellsTheOperatorOnce$|TestH8ClaimingAgainWritesNothingAndTellsOnce$' ./cmd/handoff
echo "ALL DONE $(t)" > "$R/done"
