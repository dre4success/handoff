## run.sh
#!/bin/bash
S=<scratchpad>
cd "$S/wt-h25" || exit 9
export HANDOFF_TEST_NOTIFY="$S/h25/race/alerts.txt" HANDOFF_TEST_AWAKE="$S/h25/race/awake.txt"
export HOME="$S/h25/race/home" CLAUDE_CONFIG_DIR="$S/h25/race/home/.claude" CODEX_HOME="$S/h25/race/home/.codex"
mkdir -p "$CLAUDE_CONFIG_DIR" "$CODEX_HOME"
unset HANDOFF_ROLE CLAUDE_CODE_SESSION_ID CLAUDE_PID CODEX_THREAD_ID
echo "start $(date -u '+%Y-%m-%d %H:%M:%S UTC') commit $(git rev-parse HEAD)"
s=$(date +%s)
go test -race -count=1 -v ./... > "$S/h25/race/go-test.out" 2>&1
code=$?
echo "exit $code after $(( $(date +%s) - s )) s"
echo "pass: $(grep -c '^--- PASS' "$S/h25/race/go-test.out") fail: $(grep -c '^--- FAIL' "$S/h25/race/go-test.out")"
grep -E '^(ok|FAIL|---FAIL|panic)' "$S/h25/race/go-test.out"
echo "alerts: $(cat "$S/h25/race/alerts.txt" 2>/dev/null | wc -l | tr -d ' ')"

