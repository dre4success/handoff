## I. Source: the sweep in bind that deletes a binding with no mark, and the two that make a mark
$ sed -n 408,423p cmd/handoff/session.go
	now := time.Now().UTC()
	var drop, lose []binding
	for _, b := range bs {
		mine := b.Session == s.ID || (s.PID > 0 && b.PID == s.PID)
		switch {
		case mine:
			drop = append(drop, b)
		case b.Role == role:
			// The session that had the role is marked, not forgotten,
			// running or not: a session can be resumed under its id.
			lose = append(lose, b)
			took = took || b.running()
		case !b.running():
			drop = append(drop, b)
		}
	}

